# --- Required for a separate-domain deployment ---

# The public URL of the deployed api-server service (no trailing slash).
# Set this in Render's service Environment Variables BEFORE the first build — Vite
# inlines it into the bundle at build time, so changing it later requires
# a redeploy (not just a restart).
# Example:
# VITE_API_URL=https://punjab-blood-connect-api.onrender.com
VITE_API_URL=

# --- Provided automatically by Render ---
PORT=4174

# --- Optional ---

# Sub-path the app is served from. Leave unset ("/") unless this app is
# mounted under a path prefix by a reverse proxy.
BASE_PATH=/
