# --- Required ---

# Provided automatically by Render's managed Postgres when linked via
# the `fromDatabase` reference in render.yaml (or Environment > Add from
# Database in the dashboard).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string used to sign JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Provided automatically by Render (do not set manually in production).
PORT=4000

# --- Recommended for production ---

# Comma-separated list of frontend origins allowed to call this API.
# If unset, CORS allows any origin (fine since auth is Bearer-token based,
# but an explicit allowlist is safer).
# Example:
# CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

NODE_ENV=production
